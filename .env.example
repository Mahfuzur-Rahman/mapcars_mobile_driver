# Copy this file to `.env` (it is bundled as an asset and read at startup).

# Mapcars API base URL.
#   Android emulator -> host PC is 10.0.2.2
#   Physical phone   -> your PC's LAN IP, e.g. http://192.168.1.20:5126
API_BASE_URL=http://10.0.2.2:5126

# Mapbox public token (pk....)
MAPBOX_TOKEN=pk.replace_me
