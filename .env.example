# Copy this file to `.env` (it is bundled as an asset and read at startup).

# Mapcars API base URL.
#   GCE test host    -> https://gce-test.mapcars.uk (current deployed test host)
#   AWS (later)      -> replace with the AWS URL once that migration happens
#   Android emulator -> host PC is 10.0.2.2
#   Physical phone   -> your PC's LAN IP, e.g. http://192.168.1.20:5126
API_BASE_URL=https://gce-test.mapcars.uk

# Google Maps key for address search (Places) + directions (Directions API).
# Needs Places API, Directions API and Geocoding API enabled on the key.
GOOGLE_MAPS_KEY=AIza_replace_me

# Restrict place search to these countries (comma-separated ISO 3166-1 codes,
# e.g. "gb" or "gb,bd"). Empty = worldwide (useful when testing abroad).
PLACES_COUNTRIES=gb

# OAuth 2.0 **Web** client ID for "Continue with Google"
# (…apps.googleusercontent.com). Passed to google_sign_in as serverClientId so
# Google mints an ID token the API can verify — the same value must be in the
# API's Google:ClientId audience list. The Android app's SHA-1 must also be
# registered on the Android OAuth client. Empty = button renders but reports
# that Google sign-in isn't set up yet.
GOOGLE_SERVER_CLIENT_ID=
